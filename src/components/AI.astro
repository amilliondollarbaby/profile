---
import SectionHead from './SectionHead.astro';
import Todo from './Todo.astro';
import { aiWorkflow } from '../data/content';
---
<section id="ai" class="section grain" aria-labelledby="ai-title">
  <div class="wrap">
    <SectionHead num="05" label="AI workflows" />
    <div class="intro">
      <h2 id="ai-title" class="display h2" data-reveal>More output.<br /><span class="serif-i"><span class="hl hl--purple">Used responsibly.</span></span></h2>
      <div data-reveal>
        <p class="lede">[DRAFT] It started as a chat assistant. I named it Babbi and built it into a working content system.</p>
        <p class="hand note">the one that helped build this site&nbsp;♡</p>
      </div>
    </div>

    <ol class="flow">
      {aiWorkflow.map((w, i) => (
        <li class="step" data-reveal>
          <span class="mono step__id">BABBI–FLOW–0{i + 1}</span>
          <span class="step__name">{w.step}</span>
          <span class:list={['step__detail', w.detail.startsWith('TODO') && 'is-todo']}>{w.detail}</span>
        </li>
      ))}
    </ol>

    <h3 class="label sub" data-reveal>Proof</h3>
    <div class="proof">
      {[1, 2].map((n) => <Todo tag={`AI proof 0${n}`} class="proof__slot">a before/after or workflow example Dione picks</Todo>)}
    </div>
  </div>
</section>
<style>
  .intro { display: grid; gap: 24px 64px; align-items: end; }
  .h2 { font-size: clamp(40px, 6vw, 96px); }
  .note { margin: 12px 0 0; font-size: 30px; color: var(--accent-text); transform: rotate(-3deg); transform-origin: left; }
  @media (min-width: 900px) { .intro { grid-template-columns: 1.4fr 1fr; } }

  .flow { list-style: none; margin: clamp(56px, 7vw, 96px) 0 0; padding: 0; border-top: 1px solid var(--line); }
  .step { display: grid; gap: 4px 32px; padding: 24px 0; border-bottom: 1px solid var(--line); }
  .step__id { color: var(--muted); }
  .step__name { font-size: clamp(28px, 3.4vw, 48px); font-weight: 600; letter-spacing: -0.03em; line-height: 1; }
  .step__detail { color: var(--body-ink); }
  .step__detail.is-todo { font-family: ui-monospace, Menlo, monospace; font-size: 14px; opacity: 0.7; }
  @media (min-width: 900px) { .step { grid-template-columns: 200px 1fr 1fr; align-items: center; } }

  .sub { display: block; margin: clamp(56px, 7vw, 96px) 0 24px; }
  .proof { display: grid; gap: 20px; }
  @media (min-width: 900px) { .proof { grid-template-columns: 1fr 1fr; } }
  .proof :global(.proof__slot) { min-height: 160px; }
</style>
