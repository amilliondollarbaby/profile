---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import SectionHead from './SectionHead.astro';
import { aiWorkflow, carousels } from '../data/content';

const covers = import.meta.glob<ImageMetadata>('../../assets/carousels/*/slide-01.jpg', { eager: true, import: 'default' });
const proof = carousels
  .filter((c) => ['02-ai-at-work-responsibly', '04-learn-ai-one-boring-task'].includes(c.folder))
  .map((c) => ({ ...c, cover: covers[`../../assets/carousels/${c.folder}/slide-01.jpg`] }));
---
<section id="ai" class="section section--dark grain" aria-labelledby="ai-title">
  <div class="wrap">
    <SectionHead num="05" label="AI workflows" />
    <div class="intro">
      <h2 id="ai-title" class="display h2" data-reveal>More output.<br /><span class="serif-i yellow">Used responsibly.</span></h2>
      <div data-reveal>
        <p class="lede">[DRAFT] It started as a chat assistant. I named it Babbi and built it into a working content system.</p>
        <p class="hand note">the one that helped build this site&nbsp;♡</p>
      </div>
    </div>

    <ol class="flow">
      {aiWorkflow.map((w, i) => (
        <li class="step" data-reveal>
          <span class="mono step__id">BABBI–FLOW–0{i + 1}</span>
          <span class="step__name">{w.step}</span>
          <span class:list={['step__detail', w.detail.startsWith('TODO') && 'is-todo']}>{w.detail}</span>
        </li>
      ))}
    </ol>

    <h3 class="label sub" data-reveal>Proof, in carousel form</h3>
    <div class="proof">
      {proof.map((p) => (
        <button class="proof__item" data-open-deck={p.folder} data-reveal>
          <Image src={p.cover} alt={`Cover slide: ${p.title}`} widths={[240, 480]} sizes="160px" loading="lazy" />
          <span><strong>{p.title}</strong><span class="label">LinkedIn carousel · {p.slides} slides · tap to swipe</span></span>
        </button>
      ))}
    </div>
  </div>
</section>
<style>
  .intro { display: grid; gap: 24px 64px; align-items: end; }
  .h2 { font-size: clamp(40px, 6vw, 96px); }
  .yellow { color: var(--yellow); }
  .note { margin: 12px 0 0; font-size: 30px; color: var(--yellow); transform: rotate(-3deg); transform-origin: left; }
  @media (min-width: 900px) { .intro { grid-template-columns: 1.4fr 1fr; } }

  .flow { list-style: none; margin: clamp(56px, 7vw, 96px) 0 0; padding: 0; border-top: 1.5px solid rgba(205, 191, 230, 0.25); }
  .step { display: grid; gap: 4px 32px; padding: 24px 0; border-bottom: 1.5px solid rgba(205, 191, 230, 0.25); }
  .step__id { color: var(--lavender); opacity: 0.8; }
  .step__name { font-size: clamp(28px, 3.4vw, 48px); font-weight: 800; letter-spacing: -0.04em; line-height: 1; }
  .step__detail { color: var(--lavender); }
  .step__detail.is-todo { font-family: ui-monospace, Menlo, monospace; font-size: 14px; opacity: 0.7; }
  @media (min-width: 900px) { .step { grid-template-columns: 200px 1fr 1fr; align-items: center; } }

  .sub { display: block; margin: clamp(56px, 7vw, 96px) 0 24px; }
  .proof { display: grid; gap: 20px; }
  @media (min-width: 900px) { .proof { grid-template-columns: 1fr 1fr; } }
  .proof__item { display: flex; align-items: center; gap: 20px; padding: 14px; border: 1.5px solid rgba(205, 191, 230, 0.3); border-radius: 18px; background: rgba(255, 255, 255, 0.04); text-align: left; cursor: zoom-in; transition: background 0.3s; }
  .proof__item:hover { background: rgba(255, 255, 255, 0.09); }
  .proof__item :global(img) { width: 120px; height: auto; border-radius: 8px; flex: none; }
  .proof__item strong { display: block; font-size: 20px; line-height: 1.2; margin-bottom: 6px; }
</style>
