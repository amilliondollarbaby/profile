---
import RunningHead from './RunningHead.astro';
import Plate from './Plate.astro';
import { aiWorkflow } from '../data/content';
---
<section id="ai" class="spread" aria-labelledby="ai-title">
  <div class="wrap">
    <RunningHead num="05" title="The system" swatch="pink" />
    <div class="grid open">
      <h2 id="ai-title" class="t-headline open__h" data-reveal>More output. <em>Used responsibly.</em></h2>
      <p class="t-deck open__deck" data-reveal><span class="tbd">[Draft]</span> It started as a chat assistant. I named it <b>Babbi</b> and built it into a working content system.</p>
    </div>

    <ol class="steps">
      {aiWorkflow.map((w, i) => (
        <li class="grid step" data-reveal>
          <span class="step__n" aria-hidden="true">0{i + 1}</span>
          <h3 class="step__name">{w.step}</h3>
          <p class:list={['step__detail', w.detail.startsWith('TODO') && 'tbd']}>{w.detail.startsWith('TODO') ? 'Detail to come from Dione.' : w.detail}</p>
        </li>
      ))}
    </ol>

    <div class="grid proof">
      <p class="t-label proof__lab">Proof</p>
      <Plate num="22" caption="A before and after, or a workflow example. Dione picks." ratio="16 / 10" class="proof__a" />
      <Plate num="23" caption="Second proof piece. To come." ratio="4 / 5" class="proof__b" />
    </div>
  </div>
</section>
<style>
  em { font-style: italic; }
  .open { margin-top: clamp(48px, 6vw, 88px); row-gap: 28px; align-items: end; }
  @media (min-width: 900px) { .open__h { grid-column: 1 / span 7; } .open__deck { grid-column: 9 / -1; } }

  .steps { list-style: none; margin: clamp(64px, 7vw, 104px) 0 0; padding: 0; border-top: 1px solid var(--ink); }
  .step { align-items: baseline; row-gap: 4px; padding: 22px 0; border-bottom: 1px solid var(--line); }
  .step__n { grid-column: 1 / span 2; font-style: italic; font-weight: 500; font-size: 22px; color: var(--muted); }
  .step__name { grid-column: 3 / -1; margin: 0; font-weight: 700; font-size: clamp(30px, 3.6vw, 56px); line-height: 1; letter-spacing: -0.025em; }
  .step__detail { grid-column: 3 / -1; margin: 0; font-style: italic; color: var(--body-ink); }
  @media (min-width: 900px) {
    .step__n { grid-column: 1 / span 1; }
    .step__name { grid-column: 2 / span 6; }
    .step__detail { grid-column: 9 / -1; }
  }

  .proof { margin-top: clamp(72px, 8vw, 120px); row-gap: 40px; align-items: end; }
  @media (min-width: 900px) { :global(.proof__a) { grid-column: 1 / span 7; } :global(.proof__b) { grid-column: 9 / -1; } }
</style>
