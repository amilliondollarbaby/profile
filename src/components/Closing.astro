---
import RunningHead from './RunningHead.astro';
import { profiles, site } from '../data/content';
const words = Array.from({ length: 6 }, () => 'Let’s work');
const sw = ['pink', 'purple', 'yellow', 'sky'];
---
<section id="contact" class="spread closing" aria-labelledby="contact-title">
  <div class="wrap">
    <RunningHead num="08" title="Let’s meet" swatch="yellow" />
  </div>

  <div class="marquee" aria-hidden="true">
    <div class="marquee__track">
      {[0, 1].map(() => (
        <span class="marquee__set">{words.map((w, i) => <span>{i % 2 ? <em>{w}</em> : w}<span class:list={['swatch', `sw-${sw[i % 4]}`]}></span></span>)}</span>
      ))}
    </div>
  </div>

  <div class="wrap">
    <div class="grid invite">
      <span class="blk blk--circle sw-purple c1" aria-hidden="true"></span>
      <h2 id="contact-title" class="t-headline invite__h" data-reveal>Got a business that needs <em>both sides running?</em></h2>
      <div class="invite__side" data-reveal>
        <p class="t-deck"><span class="tbd">[Draft]</span> Tell me what’s on your plate. We’ll see if I’m the right fit.</p>
        <p class="t-caption tbd">A few personal touches, when Dione is ready to share.</p>
        <a class="key key--wide" href={site.bookingUrl || '#contact'}><span class="key__legend" aria-hidden="true">↵ enter</span><span>Book a call</span></a>
        {!site.bookingUrl && <p class="t-caption">Booking link to come.</p>}
      </div>
    </div>

    <footer class="grid colophon">
      <div class="col">
        <p class="t-label col__h"><span class="swatch sw-pink" aria-hidden="true"></span> Contact</p>
        <p>{site.email ? <a href={`mailto:${site.email}`}>{site.email}</a> : <span class="tbd">Email to come</span>}</p>
      </div>
      <div class="col">
        <p class="t-label col__h"><span class="swatch sw-purple" aria-hidden="true"></span> Elsewhere</p>
        <ul>{profiles.map((p) => <li>{p.url ? <a href={p.url} rel="noopener" target="_blank">{p.label} ↗</a> : <span class="tbd">{p.label}, link to come</span>}</li>)}</ul>
      </div>
      <div class="col">
        <p class="t-label col__h"><span class="swatch sw-yellow" aria-hidden="true"></span> Based</p>
        <p>Davao, Philippines<br /><em>Working U.S. hours</em></p>
      </div>
      <div class="col">
        <p class="t-label col__h"><span class="swatch sw-sky" aria-hidden="true"></span> Colophon</p>
        <p>Set in Archivo and Great Vibes.</p>
      </div>
      <div class="sign">
        <p class="sign__name">Danielle Sellado <em>Dioné</em></p>
        <p class="t-label">© {new Date().getFullYear()} {site.fullName}</p>
      </div>
    </footer>
  </div>
</section>
<style>
  .closing { padding-bottom: 40px; overflow: hidden; }
  .marquee { overflow: hidden; margin-top: clamp(40px, 5vw, 72px); padding-block: 8px 24px; border-bottom: 1px solid var(--line); }
  .marquee__track { display: flex; width: max-content; animation: marquee 40s linear infinite; }
  .marquee__set { display: flex; font-size: clamp(56px, 8vw, 132px); font-weight: 800; font-stretch: 125%; text-transform: uppercase; letter-spacing: -0.02em; line-height: 1.1; white-space: nowrap; }
  .marquee__set > span { display: inline-flex; align-items: center; gap: 0.3em; padding-right: 0.3em; }
  .marquee__set em { font-family: var(--script); font-style: normal; font-weight: 400; font-stretch: 100%; text-transform: none; font-size: 1.2em; letter-spacing: 0; }
  .marquee .swatch { width: 0.2em; height: 0.2em; }
  @keyframes marquee { to { transform: translateX(-50%); } }

  .invite { position: relative; margin-top: clamp(64px, 8vw, 120px); row-gap: 40px; align-items: end; }
  .invite > :not(.blk) { position: relative; z-index: 1; }
  .c1 { width: clamp(160px, 17vw, 260px); aspect-ratio: 1; right: -5vw; bottom: -110px; }
  .invite__side { display: grid; gap: 20px; justify-items: start; }
  @media (min-width: 900px) { .invite__h { grid-column: 1 / span 7; } .invite__side { grid-column: 9 / -1; } }

  .colophon { margin-top: clamp(96px, 10vw, 160px); padding-top: 20px; border-top: 1px solid var(--ink); row-gap: 32px; }
  .col { grid-column: span 6; }
  .col__h { display: flex; align-items: center; gap: 8px; }
  .col p, .col ul { margin: 8px 0 0; }
  .col ul { list-style: none; padding: 0; }
  .col a { text-decoration: none; border-bottom: 1px solid var(--line); }
  @media (min-width: 900px) { .col { grid-column: span 3; } }
  .sign__name { margin: 0; font-weight: 800; font-stretch: 125%; text-transform: uppercase; font-size: clamp(28px, 4vw, 60px); line-height: 1; letter-spacing: -0.02em; }
  .sign__name em { font-family: var(--script); font-style: normal; font-weight: 400; font-stretch: 100%; text-transform: none; font-size: 1.3em; }
  .sign { display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: 16px; margin-top: 40px; }
</style>
