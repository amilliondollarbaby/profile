---
import RunningHead from './RunningHead.astro';

// Work strip: one card per piece. Real files replace these as Dione sends them.
const work = [
  { kind: 'Graphic', n: '01', ratio: '4 / 5' },
  { kind: 'Design', n: '02', ratio: '1 / 1' },
  { kind: 'Graphic', n: '03', ratio: '4 / 5' },
  { kind: 'AI motion', n: '04', ratio: '16 / 10' },
  { kind: 'Design', n: '05', ratio: '1 / 1' },
  { kind: 'Reel', n: '06', ratio: '9 / 16' },
  { kind: 'Graphic', n: '07', ratio: '1 / 1' },
  { kind: 'Design', n: '08', ratio: '4 / 5' },
  { kind: 'AI motion', n: '09', ratio: '16 / 10' },
  { kind: 'Reel', n: '10', ratio: '9 / 16' },
];
---
<!-- Work showcase: her photo centre stage, title split around it, work cards sliding across the middle. -->
<section id="creative" class="spread showcase" aria-labelledby="creative-title">
  <div class="wrap">
    <RunningHead num="04" title="Socials & creative" swatch="yellow" />
  </div>

  <div class="stage">
    <h2 id="creative-title" class="sr-only">Socials and creative work</h2>
    {['tl', 'tr', 'bl', 'br'].map((pos) => (
      <svg class={`mark mark--${pos}`} aria-hidden="true" width="44" height="18" viewBox="0 0 44 18" fill="none" stroke="currentColor" stroke-width="1"><circle cx="9" cy="9" r="5" /><circle cx="9" cy="9" r="1.6" fill="currentColor" /><circle cx="35" cy="9" r="6" /><path d="M35 1v16M27 9h16" /></svg>
    ))}

    <p class="t-display ttl ttl--l" aria-hidden="true">Socials</p>
    <p class="t-display ttl ttl--r" aria-hidden="true"><em>&amp;</em> Creative</p>

    <div class="cred cred--l t-label">
      <p>By Danielle Sellado</p>
      <p>Graphics · designs<br />AI motion · reels</p>
    </div>
    <div class="cred cred--r t-label">
      <p>Social media strategy</p>
      <p>Creative operations</p>
    </div>

    <figure class="portrait">
      <div class="portrait__frame"><span class="t-label">Photo · cutout of Dione<br />Shoot to come</span></div>
    </figure>

    <div class="strip" aria-label="Work">
      <ul class="strip__track">
        {[0, 1].map((copy) => work.map((w) => (
          <li class="card" style={`--ratio:${w.ratio}`} aria-hidden={copy === 1 ? 'true' : undefined}>
            <span class="t-label card__tag">{w.kind} {w.n}</span>
            <span class="card__tbd">To come</span>
          </li>
        )))}
      </ul>
    </div>

    <p class="t-label foot foot--l">Plates 01–10</p>
    <p class="t-label foot foot--r">Work to come from Dione</p>
  </div>
</section>
<style>
  .showcase { padding-bottom: 0; overflow: hidden; }

  .stage { position: relative; height: clamp(760px, 100svh, 1000px); margin-top: 8px; color: var(--ink); }

  .mark { position: absolute; color: var(--muted); z-index: 5; }
  .mark--tl { top: 16px; left: var(--gutter); }
  .mark--tr { top: 16px; right: var(--gutter); transform: scaleX(-1); }
  .mark--bl { bottom: 16px; left: var(--gutter); }
  .mark--br { bottom: 16px; right: var(--gutter); transform: scaleX(-1); }

  /* Two staggered rows: "Socials" top left, "& Creative" below it on the right. */
  .stage { --s: clamp(48px, 7.6vw, 128px); }
  .ttl { position: absolute; z-index: 3; top: 6%; margin: 0; font-size: var(--s); white-space: nowrap; }
  .ttl--l { left: var(--gutter); }
  .ttl--r { right: var(--gutter); top: calc(6% + var(--s) * 0.95); }

  .cred { position: absolute; z-index: 3; display: grid; gap: 10px; color: var(--ink); }
  .cred p { margin: 0; }
  .cred--l { left: var(--gutter); top: calc(6% + var(--s) * 1.95 + 16px); }
  .cred--r { right: var(--gutter); top: calc(6% + 10px); text-align: right; }

  /* Her photo stands centre stage with a soft contact shadow. No frame. */
  .portrait { position: absolute; z-index: 1; left: 50%; bottom: 0; transform: translateX(-50%); margin: 0; width: min(38vw, 520px); height: 86%; }
  .portrait::after { content: ''; position: absolute; left: 6%; right: 6%; bottom: -18px; height: 36px; border-radius: 50%; background: radial-gradient(closest-side, rgba(90, 60, 120, 0.22), transparent); }
  .portrait__frame { height: 100%; display: grid; place-items: end center; padding-bottom: 40px; text-align: center; background: radial-gradient(50% 50% at 50% 50%, rgba(255, 255, 255, 0.95), rgba(255, 255, 255, 0)); }

  .strip { position: absolute; z-index: 4; left: 0; right: 0; top: 50%; overflow: hidden; padding-block: 10px 24px; }
  .strip__track { display: flex; align-items: center; gap: 16px; width: max-content; margin: 0; padding: 0; list-style: none; animation: slide 46s linear infinite; }
  .strip:hover .strip__track { animation-play-state: paused; }
  @keyframes slide { to { transform: translateX(calc(-50% - 8px)); } }

  .card { position: relative; height: clamp(150px, 15vw, 230px); aspect-ratio: var(--ratio); border-radius: var(--radius); background: var(--frame-fill); border: 1px solid var(--frame-line); box-shadow: 0 18px 40px rgba(90, 60, 120, 0.14); display: grid; place-items: center; }
  .card__tag { position: absolute; left: 14px; top: 10px; white-space: nowrap; color: var(--ink); }
  .card__tbd { font-family: var(--script); font-size: 26px; color: var(--muted); }

  .foot { position: absolute; z-index: 3; bottom: 48px; margin: 0; color: var(--ink); }
  .foot--l { left: var(--gutter); }
  .foot--r { right: var(--gutter); }

  @media (max-width: 899px) {
    .stage { height: 860px; }
    .stage { --s: 11.4vw; }
    .ttl--l { top: 40px; }
    .ttl--r { top: calc(40px + var(--s) * 0.95); }
    .cred--l { top: calc(40px + var(--s) * 1.95 + 16px); }
    .cred--r { display: none; }
    .portrait { width: 74vw; height: 64%; }
    .strip { top: 56%; }
    .card { height: 140px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .strip { overflow-x: auto; }
    .strip__track { animation: none; padding-inline: var(--gutter); }
  }
</style>
