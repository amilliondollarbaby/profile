---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import SectionHead from './SectionHead.astro';
import Todo from './Todo.astro';
import Logo from './Logo.astro';
import { carousels, creativeTabs } from '../data/content';

const files = import.meta.glob<ImageMetadata>('../../assets/carousels/*/*.jpg', { eager: true, import: 'default' });
const slidesFor = (folder: string) =>
  Object.entries(files)
    .filter(([path]) => path.includes(`/${folder}/`))
    .sort(([a], [b]) => a.localeCompare(b))
    .map(([, img]) => img);

const decks = carousels.map((c) => ({ ...c, images: slidesFor(c.folder) }));
const swatches = [
  ['--purple', '#2D1B4E'], ['--yellow', '#F4C542'], ['--pink', '#E0216F'],
  ['--lavender', '#CDBFE6'], ['--blush', '#F7C6D9'], ['--lilac-bg', '#F3EEF9'],
];
---
<section id="creative" class="section section--white grain" aria-labelledby="creative-title">
  <div class="wrap">
    <SectionHead num="04" label="Socials & creative" />
    <div class="intro">
      <h2 id="creative-title" class="display h2" data-reveal>Built to be <span class="serif-i accent">sent.</span></h2>
      <p class="lede" data-reveal>[DRAFT] Carousels, designs, motion and reels. Each one with the thinking behind it.</p>
    </div>

    <div class="tabs" role="tablist" aria-label="Formats" data-tabs>
      {creativeTabs.map((t, i) => (
        <button role="tab" id={`tab-${t.id}`} aria-controls={`panel-${t.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} class="tab">
          {t.label} <span class="tab__count">({String(t.count).padStart(2, '0')})</span>
        </button>
      ))}
    </div>
  </div>

  <!-- Graphics: real carousels in a LinkedIn-post frame. Click to swipe the full deck. -->
  <div role="tabpanel" id="panel-graphics" aria-labelledby="tab-graphics" class="panel">
    <div class="rail posts">
      {decks.map((d, i) => (
        <article class="post" style={`--tilt:${[-1.2, 0.8, -0.6, 1.1][i % 4]}deg`}>
          <header class="post__head">
            <span class="post__avatar"><Logo size={14} /></span>
            <span><strong>Dioné</strong><span class="label post__meta">LinkedIn · carousel</span></span>
          </header>
          <button class="post__media" data-open-deck={d.folder} aria-label={`Open “${d.title}”, ${d.slides} slides`}>
            <Image src={d.images[0]} alt={`Cover slide: ${d.title}`} widths={[360, 540, 720]} sizes="(max-width: 600px) 80vw, 360px" loading="lazy" />
            {d.slides > 1 && <span class="post__count">1/{d.slides}</span>}
          </button>
          <p class="post__ctx">LinkedIn carousel · {d.topic} · {d.slides} {d.slides === 1 ? 'slide' : 'slides'}</p>
        </article>
      ))}
    </div>

    {decks.map((d) => (
      <dialog class="deck" id={`deck-${d.folder}`} aria-label={d.title}>
        <div class="deck__bar">
          <span class="label">{d.title}</span>
          <form method="dialog"><button class="deck__close" aria-label="Close">Close ✕</button></form>
        </div>
        <div class="deck__track" tabindex="0">
          {d.images.map((img, n) => (
            <Image src={img} alt={`${d.title}, slide ${n + 1} of ${d.slides}`} widths={[540, 1080]} sizes="(max-width: 600px) 88vw, 540px" loading="lazy" />
          ))}
        </div>
        <p class="deck__hint hand">swipe →</p>
      </dialog>
    ))}
  </div>

  <!-- Designs: the Dioné brand system is the first real piece. -->
  <div role="tabpanel" id="panel-designs" aria-labelledby="tab-designs" class="panel">
    <div class="rail cards">
      <article class="card brand">
        <div class="brand__art">
          <Logo size={44} />
          <div class="brand__type">
            <span class="display">Aa</span><span class="serif-i">Aa</span><span class="hand">Aa</span>
          </div>
          <div class="brand__swatches">{swatches.map(([n, hex]) => <span title={`${n} ${hex}`} style={`background:${hex}`}></span>)}</div>
        </div>
        <p class="card__ctx">Brand system · Dioné · logo, palette & type</p>
      </article>
      {[2, 3, 4, 5].map((n) => (
        <div class="card"><Todo tag={`design 0${n}`} class="card__todo">layout or brand system</Todo></div>
      ))}
    </div>
  </div>

  <div role="tabpanel" id="panel-motion" aria-labelledby="tab-motion" class="panel">
    <div class="rail wides">
      {[1, 2, 3, 4, 5].map((n) => <Todo tag={`AI motion 0${n}`} class="wide">waiting on Dione’s files</Todo>)}
    </div>
  </div>

  <div role="tabpanel" id="panel-reels" aria-labelledby="tab-reels" class="panel">
    <div class="rail reels">
      {[1, 2, 3, 4, 5].map((n) => <Todo tag={`reel 0${n}`} class="reel">waiting on Dione’s files</Todo>)}
    </div>
  </div>
</section>

<style>
  .intro { display: grid; gap: 24px 64px; align-items: end; }
  .h2 { font-size: clamp(40px, 6vw, 96px); }
  .accent { color: var(--pink-deep); }
  @media (min-width: 900px) { .intro { grid-template-columns: 1.4fr 1fr; } }

  .tabs { display: flex; flex-wrap: wrap; gap: 10px; margin-top: clamp(40px, 5vw, 64px); }
  .tab { padding: 10px 18px; border: 1.5px solid var(--purple); border-radius: 999px; background: transparent; font-size: 15px; font-weight: 600; cursor: pointer; }
  .tab[aria-selected='true'] { background: var(--purple); color: var(--white); }
  .tab__count { opacity: 0.6; font-variant-numeric: tabular-nums; }
  .panel { margin-top: 16px; }
  .panel[hidden] { display: none; }

  /* LinkedIn-style post frame */
  .posts { grid-auto-columns: min(80vw, 380px); padding-block: 32px 40px; }
  .post { padding: 14px; border-radius: 18px; background: var(--white); box-shadow: var(--shadow); transform: rotate(var(--tilt)); transition: transform 0.4s cubic-bezier(.2,.7,.2,1); }
  .post:hover { transform: rotate(0deg) translateY(-6px); }
  .post__head { display: flex; align-items: center; gap: 10px; margin-bottom: 12px; font-size: 15px; line-height: 1.2; }
  .post__head strong { display: block; }
  .post__meta { font-size: 13px; }
  .post__avatar { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%; background: var(--lilac-bg); overflow: hidden; }
  .post__avatar :global(.serif-i) { display: none; }
  .post__media { position: relative; display: block; width: 100%; padding: 0; border: 0; border-radius: 10px; overflow: hidden; cursor: zoom-in; background: var(--lilac-bg); }
  .post__media :global(img) { width: 100%; height: auto; aspect-ratio: 4 / 5; object-fit: cover; }
  .post__count { position: absolute; top: 10px; right: 10px; padding: 3px 9px; border-radius: 999px; background: rgba(45, 27, 78, 0.8); color: var(--white); font-size: 12px; font-weight: 600; }
  .post__ctx { margin: 12px 2px 2px; font-size: 14px; font-weight: 600; color: var(--muted); }

  /* Deck viewer */
  .deck { width: min(100vw, 1180px); max-width: 100vw; max-height: 100svh; padding: 0; border: 0; background: transparent; color: var(--white); }
  .deck::backdrop { background: rgba(45, 27, 78, 0.92); }
  .deck__bar { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 16px var(--gutter); }
  .deck__close { padding: 8px 14px; border: 1.5px solid var(--lavender); border-radius: 999px; background: none; color: var(--white); font-weight: 600; cursor: pointer; }
  .deck__bar .label { color: var(--lavender); }
  .deck__track { display: grid; grid-auto-flow: column; grid-auto-columns: min(88vw, 540px); gap: 16px; overflow-x: auto; scroll-snap-type: x mandatory; padding: 8px var(--gutter) 16px; scroll-padding-inline: var(--gutter); }
  .deck__track :global(img) { width: 100%; height: auto; max-height: 74svh; object-fit: contain; border-radius: 8px; scroll-snap-align: start; }
  .deck__hint { margin: 0 var(--gutter) 16px; font-size: 28px; color: var(--yellow); text-align: right; }

  /* Designs, motion, reels */
  .cards { grid-auto-columns: min(80vw, 380px); padding-block: 32px 40px; }
  .card { display: flex; flex-direction: column; }
  .card :global(.card__todo) { aspect-ratio: 4 / 5; }
  .brand__art { aspect-ratio: 4 / 5; display: grid; align-content: space-between; padding: 28px; border-radius: 20px; background: var(--lilac-bg); box-shadow: var(--shadow); transform: rotate(-1deg); }
  .brand__type { display: flex; align-items: baseline; gap: 18px; font-size: 64px; }
  .brand__type .hand { color: var(--pink-deep); }
  .brand__swatches { display: grid; grid-template-columns: repeat(6, 1fr); gap: 8px; }
  .brand__swatches span { aspect-ratio: 1; border-radius: 50%; border: 1.5px solid rgba(45, 27, 78, 0.12); }
  .card__ctx { margin: 14px 2px 0; font-size: 14px; font-weight: 600; color: var(--muted); }

  .wides { grid-auto-columns: min(86vw, 560px); padding-block: 32px 40px; }
  .wides :global(.wide) { aspect-ratio: 16 / 9; }
  .reels { grid-auto-columns: min(60vw, 260px); padding-block: 32px 40px; }
  .reels :global(.reel) { aspect-ratio: 9 / 16; }
</style>
