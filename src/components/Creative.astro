---
import RunningHead from './RunningHead.astro';
import Plate from './Plate.astro';
import Logo from './Logo.astro';
import { creativeTabs } from '../data/content';

// Asymmetric magazine layouts: [column span, aspect ratio, top offset] per plate.
const layouts = {
  graphics: [[5, '4 / 5', 0], [4, '1 / 1', 140], [3, '4 / 5', 40], [3, '1 / 1', 0], [5, '4 / 5', -60], [4, '4 / 5', 60]],
  designs: [[6, '4 / 5', 0], [3, '1 / 1', 120], [3, '4 / 5', 40], [5, '1 / 1', 0], [7, '16 / 10', -40]],
  motion: [[7, '16 / 9', 0], [5, '16 / 9', 120], [4, '16 / 9', 0], [4, '16 / 9', 60], [4, '16 / 9', 20]],
  reels: [[3, '9 / 16', 0], [3, '9 / 16', 100], [3, '9 / 16', 30], [3, '9 / 16', 130], [3, '9 / 16', 0]],
} as const;
const captions = {
  graphics: 'Social graphic. Format, purpose and size to come.',
  designs: 'Layout or brand system. To come.',
  motion: 'AI motion piece. To come.',
  reels: 'Reel. To come.',
};
const swatches = [['Ink', '#141414'], ['Studio', '#EBEBE9'], ['Pink', '#FAD4E4'], ['Purple', '#E4DAF8'], ['Yellow', '#FCF0B4'], ['Sky', '#D2E8FB']];
let plateNo = 1;
---
<section id="creative" class="spread" aria-labelledby="creative-title">
  <div class="wrap">
    <RunningHead num="04" title="Portfolio" swatch="yellow" />
    <div class="grid open">
      <h2 id="creative-title" class="t-headline open__h" data-reveal>Built to be <em>seen.</em></h2>
      <p class="t-deck open__deck" data-reveal><span class="tbd">[Draft]</span> Graphics, designs, motion and reels. Each one with the thinking behind it.</p>
    </div>

    <div class="tabs" role="tablist" aria-label="Formats" data-tabs>
      {creativeTabs.map((t, i) => (
        <button role="tab" id={`tab-${t.id}`} aria-controls={`panel-${t.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} class="tab">
          {t.label}<sup>{String(t.count).padStart(2, '0')}</sup>
        </button>
      ))}
    </div>
  </div>

  {creativeTabs.map((t) => (
    <div role="tabpanel" id={`panel-${t.id}`} aria-labelledby={`tab-${t.id}`} class="wrap panel">
      <div class="gallery">
        {layouts[t.id].map(([span, ratio, offset], i) => (
          <div class="g-item" style={`--span:${span};--off:${offset}px`}>
            {t.id === 'designs' && i === 0 ? (
              <Plate num={String(plateNo++).padStart(2, '0')} caption="Brand system · Dioné · type, palette and mark" ratio={ratio} accent="yellow">
                <div class="brand">
                  <Logo size={40} />
                  <p class="brand__type"><span class="b1">Aa</span><span class="b2">Aa</span><span class="b3">AA</span></p>
                  <ul class="brand__sw">{swatches.map(([n, hex]) => <li><span style={`background:${hex}`}></span>{n}</li>)}</ul>
                </div>
              </Plate>
            ) : (
              <Plate num={String(plateNo++).padStart(2, '0')} caption={captions[t.id]} ratio={ratio} accent={i === 0 ? 'yellow' : undefined} />
            )}
          </div>
        ))}
      </div>
    </div>
  ))}
</section>
<style>
  em { font-style: italic; }
  .open { margin-top: clamp(48px, 6vw, 88px); row-gap: 28px; align-items: end; }
  @media (min-width: 900px) { .open__h { grid-column: 1 / span 7; } .open__deck { grid-column: 9 / -1; } }

  .tabs { display: flex; flex-wrap: wrap; gap: 8px 32px; margin-top: clamp(48px, 5vw, 72px); padding-top: 16px; border-top: 1px solid var(--ink); }
  .tab { padding: 0 0 4px; border: 0; border-bottom: 1px solid transparent; background: none; font-size: clamp(20px, 1.8vw, 26px); font-weight: 600; letter-spacing: -0.01em; color: var(--muted); cursor: pointer; }
  .tab sup { font-size: 0.45em; font-weight: 500; letter-spacing: 0.1em; margin-left: 3px; }
  .tab[aria-selected='true'] { color: var(--ink); border-bottom-color: var(--ink); font-style: italic; }
  .panel { margin-top: 48px; }
  .panel[hidden] { display: none; }

  /* Mobile: a swipe rail. Desktop: asymmetric 12-column layout. */
  .gallery { display: grid; grid-auto-flow: column; grid-auto-columns: 78%; gap: 20px; overflow-x: auto; scroll-snap-type: x mandatory; padding-bottom: 24px; }
  .g-item { scroll-snap-align: start; }
  @media (min-width: 900px) {
    .gallery { grid-auto-flow: row; grid-template-columns: repeat(12, minmax(0, 1fr)); grid-auto-columns: auto; column-gap: var(--col-gap); row-gap: 72px; overflow: visible; align-items: start; }
    .g-item { grid-column: span var(--span); margin-top: var(--off); }
  }

  .brand { width: 100%; height: 100%; padding: 8% 9%; background: var(--card); display: flex; flex-direction: column; justify-content: space-between; }
  .brand__type { display: flex; gap: 18px; align-items: baseline; margin: 0; font-size: clamp(48px, 5vw, 80px); line-height: 1; }
  .b1 { font-weight: 800; } .b2 { font-style: italic; } .b3 { font-size: 0.4em; letter-spacing: 0.2em; font-weight: 500; }
  .brand__sw { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px 12px; font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--muted); }
  .brand__sw li { display: flex; align-items: center; gap: 8px; }
  .brand__sw span { width: 16px; height: 16px; border-radius: 50%; border: 1px solid var(--line); }
</style>
