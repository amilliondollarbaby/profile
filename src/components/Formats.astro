---
// Section 04, continued: one block per format so each is easy to find.
// Every card is a slot until Dione sends the real files.
const formats = [
  { id: 'graphics', n: '04.1', title: 'Graphics', script: 'for socials', sw: 'pink', count: 6, ratio: '4 / 5', cols: 3 },
  { id: 'designs', n: '04.2', title: 'Designs', script: '& brand systems', sw: 'purple', count: 6, ratio: '1 / 1', cols: 3 },
  { id: 'motion', n: '04.3', title: 'AI', script: 'motion', sw: 'yellow', count: 4, ratio: '16 / 9', cols: 2 },
  { id: 'reels', n: '04.4', title: 'Reels', script: 'short-form', sw: 'sky', count: 5, ratio: '9 / 16', cols: 5 },
] as const;
---
<section class="spread formats" aria-label="Work by format">
  <div class="wrap">
    {formats.map((f) => (
      <div id={f.id} class="fmt">
        <div class="fmt__head" data-reveal>
          <p class="pill"><span class:list={['swatch', `sw-${f.sw}`]} aria-hidden="true"></span>({f.n}) // {f.title === 'AI' ? 'AI motion' : f.title}</p>
          <h3 class="t-headline fmt__title">{f.title} <em>{f.script}</em></h3>
          <p class="t-label fmt__count"><span class:list={['tick', 'tick--s', `sw-${f.sw}`]} aria-hidden="true"></span>{String(f.count).padStart(2, '0')} pieces · to come</p>
        </div>
        <ul class:list={['fmt__grid', `is-${f.id}`]} style={`--cols:${f.cols};--ratio:${f.ratio}`}>
          {Array.from({ length: f.count }, (_, i) => (
            <li class:list={['slot', f.id === 'reels' && 'slot--phone']} data-reveal>
              <span class="t-label slot__tag"><span class:list={['swatch', `sw-${f.sw}`]} aria-hidden="true"></span>{f.title === 'AI' ? 'AI motion' : f.title.replace(/s$/, '')} {String(i + 1).padStart(2, '0')}</span>
              <span class="slot__tbd">To come</span>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</section>
<style>
  .formats { padding-top: clamp(48px, 6vw, 96px); }
  .fmt + .fmt { margin-top: clamp(88px, 10vw, 150px); }
  .fmt { scroll-margin-top: calc(var(--nav-h) + 24px); }

  .fmt__head { display: grid; gap: 18px; padding-bottom: 20px; border-bottom: 1px solid var(--ink); }
  .fmt__head .pill { margin: 0; justify-self: start; }
  .fmt__count { display: flex; align-items: center; gap: 10px; color: var(--ink); }
  @media (min-width: 900px) {
    .fmt__head { grid-template-columns: auto 1fr auto; align-items: end; gap: 32px; }
    .fmt__head .pill { align-self: center; }
  }

  .fmt__grid { list-style: none; margin: 28px 0 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
  @media (min-width: 900px) { .fmt__grid { grid-template-columns: repeat(var(--cols), minmax(0, 1fr)); gap: 24px; } }
  .is-motion { grid-template-columns: 1fr; }
  @media (min-width: 900px) { .is-motion { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  /* Reels swipe sideways on phones. */
  @media (max-width: 899px) {
    .is-reels { grid-auto-flow: column; grid-template-columns: none; grid-auto-columns: 44%; overflow-x: auto; scroll-snap-type: x mandatory; padding-bottom: 12px; }
    .is-reels > * { scroll-snap-align: start; }
  }

  .slot { position: relative; aspect-ratio: var(--ratio); display: grid; place-items: center; border-radius: var(--radius); background: var(--frame-fill); border: 1px solid var(--frame-line); box-shadow: 0 14px 30px rgba(28, 26, 31, 0.07); }
  .slot__tag { position: absolute; left: 14px; top: 12px; display: inline-flex; align-items: center; gap: 7px; color: var(--ink); white-space: nowrap; }
  .slot__tbd { font-family: var(--script); font-size: 26px; color: var(--muted); }
  /* Reels look like a phone screen: rounder corners and a small notch. */
  .slot--phone { border-radius: 26px; }
  .slot--phone::before { content: ''; position: absolute; top: 9px; left: 50%; width: 30%; height: 6px; transform: translateX(-50%); border-radius: 6px; background: var(--ink); opacity: 0.85; }
  .slot--phone .slot__tag { top: 26px; }

</style>
