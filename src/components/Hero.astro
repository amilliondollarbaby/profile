---
import SectionHead from './SectionHead.astro';
import { site } from '../data/content';
---
<section id="intro" class="hero section section--dark grain" aria-labelledby="hero-title">
  <div class="wrap hero__inner">
    <SectionHead num="01" label="Introduction" note="Davao, PH · U.S. hours" />
    <h1 id="hero-title" class="display hero__title">
      <span class="hero__line" data-hero-line>{site.heroLine[0]}</span>
      <span class="hero__line serif-i" data-hero-line>{site.heroLine[1]}</span>
    </h1>
    <p class="hero__pos" data-reveal>
      {site.positioning.map((p) => <span class="pos">{p}</span>)}
    </p>
    <a class="hero__cue" href="#partnership">
      <span class="hand">scroll</span>
      <svg aria-hidden="true" width="34" height="56" viewBox="0 0 34 56" fill="none" stroke="var(--pink)" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 4 C 10 18, 24 30, 16 50"/><path d="M6 40 L16 51 L26 40"/></svg>
    </a>
  </div>
</section>
<style>
  .hero { min-height: 100svh; display: flex; align-items: stretch; padding-block: calc(var(--nav-h) + 32px) 48px; overflow: hidden; }
  .hero__inner { display: flex; flex-direction: column; }
  .hero__title { font-size: clamp(48px, 8.4vw, 148px); max-width: 15ch; margin-block: auto 0; }
  .hero__line { display: block; }
  .hero__line.serif-i { color: var(--yellow); margin-top: 0.08em; }
  .hero__pos { display: flex; flex-wrap: wrap; gap: 6px 14px; margin: clamp(28px, 4vw, 48px) 0 0; font-size: clamp(16px, 1.5vw, 20px); font-weight: 600; color: var(--lavender); }
  .pos + .pos::before { content: '·'; margin-right: 14px; color: var(--pink); }
  .hero__cue { align-self: flex-end; display: flex; align-items: flex-end; gap: 6px; margin-top: auto; padding-top: 48px; text-decoration: none; color: var(--lavender); }
  .hero__cue .hand { font-size: 30px; transform: rotate(-4deg); }
</style>
