---
import { site } from '../data/content';
---
<!-- Cover, after the Calvin Klein reference: one main photo, the name in wide caps with
     "Dioné" in script woven through, outlined pills, a ghost name behind, tiny cotton candy marks. -->
<section id="intro" class="cover" aria-labelledby="hero-title">
  <div class="lines" aria-hidden="true"><span class="ln-h"></span><span class="ln-v"></span><span class="ring"></span></div>

  <p class="ghost" aria-hidden="true"><span>Sellado</span><em>Dioné</em></p>

  <span class="tick sw-pink mark-sq" aria-hidden="true"></span>
  <span class="tick tick--s sw-purple mark-sq2" aria-hidden="true"></span>
  <span class="orbit" aria-hidden="true"><i class="swatch sw-yellow"></i><i class="swatch sw-sky"></i><i class="swatch sw-pink"></i></span>
  <p class="t-label corner">Davao, PH<br />Working U.S. hours</p>

  <div class="wrap stage">
    <figure class="photo" data-reveal>
      <span class="t-label">Main photo · cutout of Dione<br />Shoot to come</span>
    </figure>

    <div class="copy">
      <p class="pills" data-reveal>
        <span class="pill"><span class="swatch sw-purple" aria-hidden="true"></span>Executive Assistant // 6+ years</span>
      </p>
      <h1 id="hero-title" class="lockup">
        <span class="sr-only">Danielle Sellado, known as Dioné</span>
        <span aria-hidden="true">
          <span class="t-display row" data-hero-line>Danielle</span>
          <span class="t-display row row--2" data-hero-line>Sellado</span>
          <em class="nick" data-hero-line>Dioné</em>
        </span>
      </h1>
      <p class="pills" data-reveal>
        <span class="pill">Social media strategy // Creative operations</span>
      </p>

      <p class="t-headline line" data-reveal>
        {site.heroLine[0]}<br />Creative enough to turn ideas into <em>execution.</em>
      </p>
    </div>
  </div>

  <div class="wrap foot">
    <a class="t-label cue" href="#partnership">Scroll ↓</a>
    <span class="ticks" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
    <span class="dash sw-sky" aria-hidden="true"></span>
  </div>
</section>
<style>
  .cover { position: relative; min-height: 100svh; padding-top: var(--nav-h); overflow: hidden; display: flex; flex-direction: column; }

  /* Thin construction lines and a ring behind the photo. */
  .lines { position: absolute; inset: 0; pointer-events: none; }
  .ln-h { position: absolute; left: 0; right: 0; top: calc(var(--nav-h) + 56px); border-top: 1px solid var(--line); }
  .ln-v { position: absolute; top: 0; bottom: 0; left: calc(var(--gutter) - 24px); border-left: 1px solid var(--line); }
  .ring { position: absolute; width: min(64vw, 620px); aspect-ratio: 1; border: 1px solid var(--line); border-radius: 50%; left: calc(var(--gutter) - 4vw); top: 16%; }

  /* Ghost name, huge and faint, behind everything. */
  .ghost { position: absolute; z-index: 0; left: 0; right: 0; bottom: -0.16em; margin: 0; text-align: center; font-size: min(24vw, 360px); font-weight: 800; font-stretch: 125%; text-transform: uppercase; line-height: 1; letter-spacing: -0.03em; color: rgba(28, 26, 31, 0.045); white-space: nowrap; pointer-events: none; }
  .ghost em { position: absolute; left: 50%; top: 4%; transform: translateX(-30%) rotate(-6deg); font-family: var(--script); font-style: normal; font-weight: 400; font-stretch: 100%; text-transform: none; font-size: 0.8em; color: rgba(28, 26, 31, 0.06); }

  .mark-sq { position: absolute; z-index: 2; left: var(--gutter); top: calc(var(--nav-h) + 76px); }
  .mark-sq2 { position: absolute; z-index: 2; left: calc(var(--gutter) + 36px); top: calc(var(--nav-h) + 94px); }
  /* Three tiny dots sitting on the ring. */
  .orbit { position: absolute; z-index: 2; width: min(64vw, 620px); aspect-ratio: 1; left: calc(var(--gutter) - 4vw); top: 16%; pointer-events: none; }
  .orbit i { position: absolute; width: 11px; height: 11px; margin: -5.5px; }
  .orbit i:nth-child(1) { left: 85.4%; top: 14.6%; }
  .orbit i:nth-child(2) { left: 100%; top: 50%; }
  .orbit i:nth-child(3) { left: 14.6%; top: 85.4%; }
  @media (max-width: 899px) { .orbit { display: none; } }
  .corner { position: absolute; z-index: 2; right: var(--gutter); top: calc(var(--nav-h) + 16px); text-align: right; color: var(--ink); }

  .stage { position: relative; z-index: 1; flex: 1; display: grid; gap: 32px; padding-top: 120px; }
  .copy { position: relative; z-index: 3; order: -1; }
  @media (max-width: 899px) { .pills .pill { white-space: normal; } .photo { min-height: 360px; } .nick { font-size: 21vw; left: 38%; top: 30%; } }

  /* Placeholder for the cutout. No frame: just a soft glow where she will stand. */
  .photo { position: relative; z-index: 2; margin: 0; min-height: 420px; display: grid; place-items: center; text-align: center; background: radial-gradient(50% 50% at 50% 50%, rgba(255, 255, 255, 0.9), rgba(255, 255, 255, 0)); }
  .photo .t-label { color: var(--body-ink); }

  .pills { margin: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .lockup { position: relative; margin: 18px 0; font-weight: 400; }
  .row { display: block; }
  .row--2 { padding-left: 0.9em; }
  /* A paper-coloured halo lets the script cut through the caps, like the reference. */
  .nick { position: absolute; left: 40%; top: 22%; font-family: var(--script); font-style: normal; font-size: min(24vw, 230px); line-height: 1; color: var(--ink); transform: rotate(-6deg); pointer-events: none; -webkit-text-stroke: 0.05em var(--paper); paint-order: stroke fill; }
  .line { max-width: 22em; margin-top: 36px; font-size: clamp(18px, 1.7vw, 26px); line-height: 1.15; }

  .foot { position: relative; z-index: 2; display: flex; justify-content: space-between; align-items: center; gap: 16px; padding-block: 20px 28px; }
  .foot .ticks { margin-left: auto; }
  .cue { color: var(--ink); text-decoration: none; }

  @media (min-width: 900px) {
    .stage { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--col-gap); align-items: center; padding-top: 72px; }
    .photo { grid-column: 1 / span 5; grid-row: 1; align-self: stretch; min-height: 0; }
    .copy { grid-column: 5 / -1; grid-row: 1; padding-left: 4%; order: 0; }
    .lockup .t-display { font-size: min(7.4vw, 124px); }
    .nick { font-size: min(13vw, 220px); left: 36%; top: 16%; }
  }
</style>
