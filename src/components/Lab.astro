---
import RunningHead from './RunningHead.astro';
import Plate from './Plate.astro';
const pieces = [
  { span: 7, ratio: '4 / 5', off: 0 },
  { span: 5, ratio: '1 / 1', off: 180 },
  { span: 4, ratio: '4 / 5', off: 0 },
  { span: 4, ratio: '1 / 1', off: 120 },
  { span: 4, ratio: '4 / 5', off: 40 },
];
---
<section id="lab" class="spread" aria-labelledby="lab-title">
  <div class="wrap">
    <RunningHead num="07" title="The lab" swatch="purple" />
    <div class="grid open">
      <h2 id="lab-title" class="t-headline open__h" data-reveal>What I build <em>when nobody’s asking.</em></h2>
      <p class="t-deck open__deck" data-reveal><span class="tbd">[Draft]</span> 3D products and experiments, each with a note on why it exists.</p>
    </div>
    <div class="lab">
      {pieces.map((p, i) => (
        <div class="lab__item" style={`--span:${p.span};--off:${p.off}px`}>
          <Plate num={String(24 + i)} caption="3D render. Why I made this: to come." ratio={p.ratio} />
        </div>
      ))}
    </div>
  </div>
</section>
<style>
  .open { margin-top: clamp(48px, 6vw, 88px); row-gap: 28px; align-items: end; }
  @media (min-width: 900px) { .open__h { grid-column: 1 / span 7; } .open__deck { grid-column: 9 / -1; } }
  .lab { margin-top: clamp(56px, 6vw, 88px); display: grid; grid-auto-flow: column; grid-auto-columns: 78%; gap: 20px; overflow-x: auto; scroll-snap-type: x mandatory; padding-bottom: 24px; }
  .lab__item { scroll-snap-align: start; }
  @media (min-width: 900px) {
    .lab { grid-auto-flow: row; grid-template-columns: repeat(12, minmax(0, 1fr)); grid-auto-columns: auto; column-gap: var(--col-gap); row-gap: 72px; overflow: visible; align-items: start; }
    .lab__item { grid-column: span var(--span); margin-top: var(--off); }
  }
</style>
