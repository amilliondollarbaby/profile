<!-- Loading intro: her name and a counter, then it fades into the page. JS removes it; without JS it never shows. -->
<div class="loader" id="loader" aria-hidden="true">
  <p class="loader__name">Danielle Sellado</p>
  <p class="t-label loader__row"><span>Loading</span><span><span id="loader-pct">0</span>%</span></p>
  <span class="loader__bar"><span id="loader-bar"></span></span>
</div>
<style>
  .loader { display: none; position: fixed; inset: 0; z-index: 100; place-content: center; justify-items: center; gap: 18px; background: var(--paper); color: var(--ink); }
  :global(.js-motion:not(.skip-loader)) .loader { display: grid; }
  .loader__name { margin: 0; font-weight: 800; font-stretch: 125%; text-transform: uppercase; font-size: clamp(32px, 5vw, 72px); letter-spacing: -0.02em; line-height: 1; }
  .loader__row { display: flex; justify-content: space-between; width: min(320px, 70vw); color: var(--body-ink); font-variant-numeric: tabular-nums; }
  .loader__bar { width: min(320px, 70vw); height: 1px; background: rgba(34, 26, 44, 0.15); }
  .loader__bar span { display: block; height: 100%; width: 0; background: var(--ink); }
</style>
