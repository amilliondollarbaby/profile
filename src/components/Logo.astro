---
import Heart from './Heart.astro';
interface Props { size?: number; }
const { size = 32 } = Astro.props;
---
<span class="logo" style={`--s:${size}px`}>
  <span class="logo__word">Dioné</span><Heart size={size * 0.9} />
</span>
<style>
  .logo { display: inline-flex; align-items: center; gap: 0.18em; font-size: var(--s); line-height: 1; }
  .logo__word { font-style: italic; font-weight: 600; letter-spacing: -0.01em; }
</style>
