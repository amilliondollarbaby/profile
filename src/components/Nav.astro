---
import Logo from './Logo.astro';
import { sections, site } from '../data/content';
const links = sections.filter((s) => !['intro', 'statement'].includes(s.id));
---
<header class="nav" id="nav">
  <div class="nav__inner wrap">
    <a href="#intro" class="nav__logo" aria-label="Dioné, back to top"><Logo size={28} /></a>
    <nav aria-label="Sections">
      <ul class="nav__links">
        {links.map((s) => (
          <li><a href={`#${s.id}`}><span class="nav__num">{s.num}</span> {s.label}</a></li>
        ))}
      </ul>
    </nav>
    <a class="pill pill--yellow nav__cta" href={site.bookingUrl || '#contact'}>Book a call</a>
  </div>
</header>
<style>
  .nav {
    position: fixed; top: 0; left: 0; right: 0; z-index: 50;
    height: var(--nav-h);
    color: var(--white);
    mix-blend-mode: normal;
    transition: background-color 0.3s, color 0.3s, box-shadow 0.3s;
  }
  .nav.is-light { background: rgba(243, 238, 249, 0.92); color: var(--purple); backdrop-filter: blur(10px); box-shadow: 0 1px 0 rgba(45, 27, 78, 0.08); }
  .nav.is-dark { background: rgba(45, 27, 78, 0.92); backdrop-filter: blur(10px); }
  .nav__inner { height: 100%; display: flex; align-items: center; justify-content: space-between; gap: 24px; }
  .nav__logo { text-decoration: none; }
  .nav__links { display: none; list-style: none; margin: 0; padding: 0; gap: 24px; }
  .nav__links a { font-size: 14px; font-weight: 600; text-decoration: none; opacity: 0.8; }
  .nav__links a:hover { opacity: 1; }
  .nav__num { opacity: 0.55; font-variant-numeric: tabular-nums; }
  .nav__cta { padding: 9px 16px; font-size: 14px; }
  @media (min-width: 1100px) { .nav__links { display: flex; } }
</style>
