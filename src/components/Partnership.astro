---
import RunningHead from './RunningHead.astro';
import { modules, principles, stats, testimonials } from '../data/content';
const friday = principles[0];
const isTodo = (s: string) => s.startsWith('TODO');
---
<section id="partnership" class="spread" aria-labelledby="partnership-title">
  <div class="wrap">
    <RunningHead num="02" title="The executive partner" swatch="purple" />

    <div class="grid open">
      <h2 id="partnership-title" class="t-headline open__h" data-reveal>Trusted with the business, <em>not just the inbox.</em></h2>
      <p class="t-deck open__deck" data-reveal><span class="tbd">[Draft]</span> Planning, strategic brainstorming, confidential client work, and the systems teams run on.</p>
    </div>

    <div class="grid body">
      <aside class="numbers" aria-labelledby="numbers-title">
        <p id="numbers-title" class="t-label">At a glance</p>
        <dl>
          {stats.map((s, i) => (
            <div class="num" data-reveal>
              <dt class="t-caption"><span class:list={['tick', 'tick--s', `sw-${['pink', 'purple', 'yellow', 'sky'][i % 4]}`]} aria-hidden="true"></span> {s.label}</dt>
              <dd class="num__v">{s.value}</dd>
            </div>
          ))}
        </dl>
      </aside>

      <div class="career">
        <p class="t-label">Career</p>
        <ol class="roles">
          {modules.map((m, i) => (
            <li class="role" data-reveal>
              <p class="t-label role__dates"><span class:list={['swatch', `sw-${['pink', 'purple', 'yellow', 'sky'][i % 4]}`]} aria-hidden="true"></span> {isTodo(m.dates) ? <span class="tbd">Dates to come</span> : m.dates}</p>
              <div>
                <h3 class="t-title">{m.role}</h3>
                <p class="role__org"><em>{m.org}</em>{m.status === 'ACTIVE' && <span class="role__now"><span class="swatch sw-purple" aria-hidden="true"></span>Current</span>}</p>
                <p class="role__line">{m.trusted[0]}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>

    <figure class="grid pull" data-reveal>
      <p class="t-label pull__lab"><span class="swatch sw-pink" aria-hidden="true"></span> How I think: {friday.title}</p>
      <blockquote class="pull__q">{friday.body}</blockquote>
      <figcaption class="pull__more">
        {principles.slice(1).map((_, i) => <p class="t-caption">Principle 0{i + 2}: <span class="tbd">to come from Dione</span></p>)}
      </figcaption>
    </figure>

    <div class="grid quotes">
      <p class="t-label quotes__lab">What leaders say</p>
      {testimonials.map((_, i) => (
        <figure class="quote" data-reveal>
          <span class="swatch sw-purple" aria-hidden="true"></span>
          <blockquote class="tbd">A real quote from a leader she has supported. To come, never invented.</blockquote>
          <figcaption class="t-label">Name, title · 0{i + 1}</figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
<style>
  .open { margin-top: clamp(48px, 6vw, 88px); row-gap: 28px; align-items: end; }
  @media (min-width: 900px) { .open__h { grid-column: 1 / span 8; } .open__deck { grid-column: 9 / -1; } }

  .body { margin-top: clamp(64px, 8vw, 120px); row-gap: 56px; }
  @media (min-width: 900px) { .numbers { grid-column: 1 / span 4; } .career { grid-column: 6 / -1; } }
  .numbers dl { margin: 16px 0 0; border-top: 1px solid var(--ink); }
  .num { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; padding: 14px 0; border-bottom: 1px solid var(--line); }
  .num__v { margin: 0; font-weight: 800; font-size: clamp(48px, 5vw, 76px); line-height: 1; letter-spacing: -0.03em; }
  .num dt { order: 2; max-width: 13em; text-align: right; }

  .roles { list-style: none; margin: 16px 0 0; padding: 0; border-top: 1px solid var(--ink); }
  .role { display: grid; gap: 6px 24px; padding: 22px 0; border-bottom: 1px solid var(--line); }
  @media (min-width: 700px) { .role { grid-template-columns: 170px 1fr; } }
  .role__dates { display: flex; align-items: center; gap: 8px; color: var(--ink); padding-top: 6px; }
  .role__org { margin: 4px 0 0; display: flex; align-items: center; gap: 14px; color: var(--body-ink); }
  .role__now { display: inline-flex; align-items: center; gap: 6px; font-size: 11px; letter-spacing: 0.2em; text-transform: uppercase; color: var(--ink); }
  .role__line { margin: 6px 0 0; color: var(--muted); font-size: 15px; }

  .pull { margin: clamp(88px, 10vw, 150px) 0 0; row-gap: 20px; }
  @media (min-width: 900px) { .pull__lab, .pull__q, .pull__more { grid-column: 2 / span 10; } }
  .pull__q { margin: 0; font-weight: 600; font-stretch: 112%; font-size: clamp(26px, 3.2vw, 50px); line-height: 1.12; letter-spacing: -0.02em; }
  .pull__lab { display: flex; align-items: center; gap: 10px; }
  .pull__more { display: flex; flex-wrap: wrap; gap: 8px 40px; padding-top: 16px; border-top: 1px solid var(--line); }

  .quotes { margin-top: clamp(80px, 9vw, 130px); row-gap: 28px; }
  .quote { margin: 0; padding-top: 20px; border-top: 1px solid var(--ink); }
  @media (min-width: 900px) { .quote { grid-column: span 4; } }
  .quote blockquote { margin: 16px 0 18px; font-size: 20px; line-height: 1.4; }
</style>
