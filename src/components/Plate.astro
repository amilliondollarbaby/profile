---
// A floating photo frame: rounded rectangle, oval or pill, with a thin light outline.
// Until Dione sends the real image it shows a soft translucent frame.
interface Props {
  num: string;
  label?: string;
  caption?: string;
  ratio?: string;
  shape?: 'rect' | 'oval' | 'pill';
  class?: string;
}
const { num, label, caption, ratio = '4 / 5', shape = 'rect', class: cls } = Astro.props;
---
<figure class:list={['plate', cls]} data-reveal>
  <div class:list={['plate__frame', `is-${shape}`]} style={`--ratio:${ratio}`}>
    <slot><span class="t-label plate__tbd">Image to come</span></slot>
  </div>
  {(label || caption) !== '' && (
    <figcaption class="plate__cap">
      <span class="t-label plate__no">{label ?? `Plate ${num}`}</span>
      {caption && <span class="t-caption">{caption}</span>}
    </figcaption>
  )}
</figure>
<style>
  .plate { margin: 0; }
  .plate__frame {
    position: relative;
    aspect-ratio: var(--ratio);
    display: grid;
    place-items: center;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--frame-fill);
    border: 1px solid var(--frame-line);
    box-shadow: 0 18px 40px rgba(90, 60, 120, 0.12);
  }
  .is-oval { border-radius: 50%; }
  .is-pill { border-radius: 999px; }
  .plate__no { white-space: nowrap; }
  .plate__cap { display: flex; gap: 14px; align-items: baseline; margin-top: 14px; }
</style>
