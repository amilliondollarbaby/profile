---
// A thick wavy ribbon with words running along it, after Dione's design-element reference.
// The text drifts along the path (scripts/main.ts); it stays still under reduced motion.
interface Props { text: string; color?: 'pink' | 'purple' | 'yellow' | 'sky'; id: string; flip?: boolean; }
const { text, color = 'pink', id, flip = false } = Astro.props;
const run = Array.from({ length: 6 }, () => `${text} ✦ `).join('');
---
<div class="ribbon" aria-hidden="true">
  <svg viewBox="0 0 1440 300" preserveAspectRatio="none" class="ribbon__svg">
    <path id={id} d={flip ? 'M-80,90 C 140,260 320,270 470,150 S 800,10 980,140 S 1300,290 1530,190' : 'M-80,210 C 140,40 320,30 470,150 S 800,290 980,160 S 1300,10 1530,110'} fill="none" stroke={`var(--cc-${color})`} stroke-width="70" stroke-linecap="round" />
    <text class="ribbon__text" dy="9"><textPath href={`#${id}`} startOffset="0" data-ribbon>{run}</textPath></text>
  </svg>
</div>
<style>
  .ribbon { position: relative; z-index: 2; margin-inline: calc(-1 * var(--gutter)); height: clamp(160px, 20vw, 300px); pointer-events: none; }
  .ribbon__svg { width: 100%; height: 100%; overflow: visible; }
  .ribbon__text { font-family: var(--sans); font-weight: 800; font-stretch: 125%; font-size: 26px; letter-spacing: 0.14em; text-transform: uppercase; fill: var(--ink); }
</style>
