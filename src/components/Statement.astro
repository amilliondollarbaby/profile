---
import { statement } from '../data/content';
---
<!-- Approved copy, word for word. A full-page pause before the creative work. -->
<section id="statement" class="statement" aria-label="Statement">
  <span class="blk blk--circle sw-pink s1" aria-hidden="true"></span>
  <span class="blk sw-purple s2" aria-hidden="true"></span>
  <span class="blk blk--pill sw-yellow s3" aria-hidden="true"></span>
  <div class="wrap statement__inner">
    <p class="pill"><span class="swatch sw-sky" aria-hidden="true"></span>(03) // Statement</p>
    <p class="statement__text">
      <span class="t-display" data-statement-line>{statement[0]}</span>
      <span class="t-display" data-statement-line><em>{statement[1]}</em></span>
      <span class="t-deck small" data-statement-line>{statement[2]}</span>
    </p>
    <span class="ticks" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
  </div>
</section>
<style>
  .statement { position: relative; overflow: hidden; min-height: 100svh; display: grid; align-items: center; padding-block: 120px; border-block: 1px solid var(--line); }
  .statement__inner { position: relative; z-index: 1; }
  .s1 { width: clamp(160px, 22vw, 340px); aspect-ratio: 1; right: -6vw; top: 10%; }
  .s2 { width: clamp(70px, 8vw, 120px); aspect-ratio: 1; left: 6vw; bottom: 14%; transform: rotate(12deg); }
  .s3 { width: clamp(120px, 16vw, 240px); height: clamp(36px, 4vw, 60px); left: -3vw; top: 18%; }
  .statement__inner { display: grid; justify-items: center; text-align: center; gap: clamp(32px, 4vw, 56px); }
  .pill { margin: 0; }
  .statement__text { margin: 0; display: grid; gap: 0.1em; }
  .statement__text .t-display { display: block; font-size: min(6.4vw, 110px); }
  .statement__text em { font-size: 1.15em; line-height: 1.1; transform: rotate(-3deg); margin-top: 0.1em; }
  .small { display: block; max-width: 22em; margin: 1.6em auto 0; }
</style>
