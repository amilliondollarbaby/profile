---
import RunningHead from './RunningHead.astro';
import { tools } from '../data/content';
---
<section id="tools" class="spread" aria-labelledby="tools-title">
  <div class="wrap">
    <RunningHead num="06" title="Credits" swatch="sky" />
    <div class="grid open">
      <h2 id="tools-title" class="t-headline open__h" data-reveal>The software, <em>for the record:</em></h2>
    </div>
    <div class="grid credits">
      {Object.entries(tools).map(([group, list]) => (
        <div class:list={['credit', group === 'Ops' && 'credit--wide']} data-reveal>
          <p class="t-label credit__h">{group}</p>
          <ul>
            {list.map((t) => <li class:list={[t.startsWith('TODO') && 'tbd']}>{t.startsWith('TODO') ? 'More to come' : t}</li>)}
          </ul>
        </div>
      ))}
    </div>
    <p class="t-caption logos">Logos to come.</p>
  </div>
</section>
<style>
  .open { margin-top: clamp(48px, 6vw, 88px); }
  @media (min-width: 900px) { .open__h { grid-column: 1 / span 9; } }
  .credits { margin-top: clamp(48px, 6vw, 80px); row-gap: 40px; }
  .credit__h { color: var(--ink); padding-bottom: 10px; border-bottom: 1px solid var(--ink); }
  .credit ul { list-style: none; margin: 0; padding: 0; }
  .credit li { padding: 10px 0; border-bottom: 1px solid var(--line); font-size: clamp(18px, 1.5vw, 22px); }
  @media (min-width: 900px) {
    .credit { grid-column: span 3; }
    .credit--wide { grid-column: span 6; }
    .credit--wide ul { columns: 2; column-gap: var(--col-gap); }
    .credit--wide li { break-inside: avoid; }
  }
  .logos { margin-top: 24px; }
</style>
