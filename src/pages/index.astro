---
import Base from '../layouts/Base.astro';
import Loader from '../components/Loader.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Partnership from '../components/Partnership.astro';
import Statement from '../components/Statement.astro';
import Creative from '../components/Creative.astro';
import Formats from '../components/Formats.astro';
import Ribbon from '../components/Ribbon.astro';
import AI from '../components/AI.astro';
import Tools from '../components/Tools.astro';
import Lab from '../components/Lab.astro';
import Closing from '../components/Closing.astro';
---
<Base>
  <Loader />
  <Nav />
  <main>
    <Hero />
    <Partnership />
    <div class="wrap"><Ribbon id="rb-1" color="pink" text="Sharp enough to run the day ✦ Creative enough to turn ideas into execution" /></div>
    <Statement />
    <Creative />
    <Formats />
    <div class="wrap"><Ribbon id="rb-2" color="yellow" flip text="Graphics ✦ Designs ✦ AI motion ✦ Reels" /></div>
    <AI />
    <Tools />
    <Lab />
    <div class="wrap"><Ribbon id="rb-3" color="sky" text="Let’s work ✦ Book a call" /></div>
    <Closing />
  </main>
  <script>
    import '../scripts/main';
  </script>
</Base>
